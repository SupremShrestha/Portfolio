# Server-only settings. Copy to .env.local for development or add to Vercel.
# NEVER prefix private credentials with VITE_.
RESEND_API_KEY=
# Use a sender on your verified Resend domain, e.g. Portfolio <hello@yourdomain.com>
CONTACT_FROM_EMAIL=
# Exact browser origins, comma-separated. Add localhost only for development.
CONTACT_ALLOWED_ORIGIN=http://localhost:5173
# Create a managed Turnstile widget and allow your deployed hostname.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
